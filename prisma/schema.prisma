generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
 url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  birthDate String?
  goal      String
  plan      String
  status    String   @default("Ativo")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules  Schedule[]
  trainings  Training[]
  progresses Progress[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  clientId  Int
  date      String
  time      String
  type      String
  status    String   @default("Agendado")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Training {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  goal      String
  duration  String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises Exercise[]
}

model Exercise {
  id          Int      @id @default(autoincrement())
  trainingId  Int
  name        String
  sets        String
  repetitions String
  weight      String
  rest        String
  notes       String?

  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
}

model Progress {
  id        Int      @id @default(autoincrement())
  clientId  Int
  date      String
  weight    Float?
  bodyFat   Float?
  chest     Float?
  waist     Float?
  hip       Float?
  arm       Float?
  thigh     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}