# Variáveis de ambiente do CoachFlow
# Copiar para `.env.local` (desenvolvimento) e configurar no hosting (produção).

# --- Base de dados (PostgreSQL) ---
# Em desenvolvimento local pode apontar para o `npx prisma dev`.
# Em produção use uma base de dados hospedada (Prisma Postgres, Neon, Supabase, Railway...).
# Exemplo: postgresql://utilizador:password@host:5432/coachflow?sslmode=require
DATABASE_URL="postgresql://utilizador:password@host:5432/coachflow?sslmode=require"

# --- NextAuth ---
# URL pública da aplicação (com domínio próprio em produção).
NEXTAUTH_URL="http://localhost:3000"
# Segredo forte e aleatório. Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="substituir-por-um-segredo-forte"

# --- Credenciais de acesso do personal trainer ---
# Usadas na página /login. NÃO colocar credenciais reais no código.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="substituir-por-uma-password-forte"
# Nome apresentado na sessão (opcional).
ADMIN_NAME="Maria Genia"
